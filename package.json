{
  "name": "omni-coder-kit",
  "version": "3.1.1",
  "description": "CLI inject mindset + SDLC workflow + skills into AI coding agents — Claude Code, Codex CLI, Cursor, Windsurf, Antigravity",
  "main": "bin/omni.js",
  "bin": {
    "omni": "bin/omni.js"
  },
  "files": [
    "bin/",
    "lib/",
    "templates/",
    "README.md",
    "README_V3.md",
    "README_V4.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node -c bin/omni.js && node --test --test-concurrency=1 test/*.test.js test/**/*.test.js && npm run test:v4",
    "test:dual": "node --test --test-concurrency=1 test/dual-*.test.js",
    "build:v4": "tsc -p tsconfig.v4.json",
    "typecheck:v4": "tsc -p tsconfig.v4.json --noEmit",
    "test:v4": "node scripts/run-v4-tests.cjs",
    "benchmark:v4": "node scripts/run-benchmark.cjs"
  },
  "keywords": [
    "ai",
    "cli",
    "claude",
    "claude-code",
    "codex",
    "cursor",
    "windsurf",
    "antigravity",
    "agents-md",
    "sdlc",
    "workflow",
    "prompt-engineering",
    "developer-tools",
    "skills-sh",
    "karpathy"
  ],
  "author": "TAV <tav99.dev@gmail.com>",
  "license": "ISC",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TAV99/omni-coder-kit.git"
  },
  "homepage": "https://github.com/TAV99/omni-coder-kit#readme",
  "bugs": {
    "url": "https://github.com/TAV99/omni-coder-kit/issues"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "type": "commonjs",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "chalk": "^4.1.2",
    "commander": "^14.0.3",
    "prompts": "^2.4.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "tsx": "^4.23.12",
    "typescript": "^5.9.3"
  }
}

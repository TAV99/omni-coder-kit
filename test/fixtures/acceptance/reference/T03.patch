+
+test('quoted fields preserve commas, escaped quotes and empty fields', () => {
+    const rows = [['id', 'title', 'note'], ['a', 'Dune, Messiah', 'He said "read"'], ['', 'plain', '']];
+    assert.deepEqual(csv.parse(csv.stringify(rows)), rows);

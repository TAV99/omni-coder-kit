        "requiredCapabilities": [
          "workspace.read",
          "workspace.write",
          "shell",
          "structured-output"
        ],
        "sideEffect": "workspace-write",
        "timeoutMs": 180000,
        "setupCommands": [
          {
            "program": "npm",
            "args": ["ci"],
            "cwd": ".",
            "timeoutMs": 180000
          }
        ],
        "requirements": [
          {
            "id": "EXT-JS-TYPECHECK",
            "text": "The pinned JavaScript project passes TypeScript type checking"
          },
          {
            "id": "EXT-JS-TEST",
            "text": "npm test runs Vitest once and exits deterministically"
          },
          {
            "id": "EXT-JS-BUILD",
            "text": "The pinned JavaScript project produces a successful production build"
          }
        ],
        "gates": [
          {
            "id": "external-typecheck",
            "command": "npm",
            "args": ["run", "typecheck"],
            "cwd": ".",
            "timeoutMs": 120000,
            "mandatory": true,
            "requirementIds": ["EXT-JS-TYPECHECK"],
            "dependsOn": [],
            "sideEffect": "read-only",
            "retrySafe": true
          },
          {
            "id": "external-test",
            "command": "npm",
            "args": ["test"],
            "cwd": ".",
            "timeoutMs": 120000,
            "mandatory": true,
            "requirementIds": ["EXT-JS-TEST"],
            "dependsOn": [],
            "sideEffect": "read-only",
            "retrySafe": true
          },
          {
            "id": "external-build",
            "command": "npm",
            "args": ["run", "build"],
            "cwd": ".",
            "timeoutMs": 120000,
            "mandatory": true,
            "requirementIds": ["EXT-JS-BUILD"],
            "dependsOn": ["external-typecheck", "external-test"],
            "sideEffect": "read-only",
            "retrySafe": true
          }
        ]

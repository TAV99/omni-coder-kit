{
  "schemaVersion": 1,
  "requirementsPath": ".omni/sdlc/requirements.md",
  "maxRepairAttemptsPerRequirement": 2,
  "gates": [
    {
      "id": "check-gate",
      "command": "node",
      "args": ["-e", "const fs=require('fs'); process.exit(fs.existsSync('fixed.txt') ? 0 : 1)"],
      "cwd": ".",
      "timeoutMs": 30000,
      "mandatory": true,
      "requirementIds": ["R1"],
      "dependsOn": [],
      "sideEffect": "read-only",
      "retrySafe": true
    }
  ]
}

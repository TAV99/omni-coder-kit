{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "__OMNI_HOOK_COMMAND_POSIX__",
            "commandWindows": "__OMNI_HOOK_COMMAND_WINDOWS__",
            "timeout": 15,
            "statusMessage": "Omni Dual session start"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "__OMNI_HOOK_COMMAND_POSIX__",
            "commandWindows": "__OMNI_HOOK_COMMAND_WINDOWS__",
            "timeout": 15,
            "statusMessage": "Omni Dual prompt authority check"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "^(Bash|apply_patch|mcp__.*)$",
        "hooks": [
          {
            "type": "command",
            "command": "__OMNI_HOOK_COMMAND_POSIX__",
            "commandWindows": "__OMNI_HOOK_COMMAND_WINDOWS__",
            "timeout": 5,
            "statusMessage": "Omni Dual pre-tool authority check"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "^(Bash|apply_patch|mcp__.*)$",
        "hooks": [
          {
            "type": "command",
            "command": "__OMNI_HOOK_COMMAND_POSIX__",
            "commandWindows": "__OMNI_HOOK_COMMAND_WINDOWS__",
            "timeout": 5,
            "statusMessage": "Omni Dual post-tool scope observation"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "__OMNI_HOOK_COMMAND_POSIX__",
            "commandWindows": "__OMNI_HOOK_COMMAND_WINDOWS__",
            "timeout": 5,
            "statusMessage": "Omni Dual completion verification"
          }
        ]
      }
    ]
  }
}

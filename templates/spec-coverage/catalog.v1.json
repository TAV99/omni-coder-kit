    {
      "id": "catalog.items",
      "label": "Catalog items",
      "answer_guidance": "Provide approved item IDs/names/durations or explicitly delegate them. Keep shared booking.services values consistent.",
      "examples": [
        {
          "items": [
            {
              "id": "consult",
              "name": "Consultation",
              "duration_minutes": 60
            }
          ]
        }
      ],
      "value_schema": {
        "type": "object",
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 1
                },
                "name": {
                  "type": "string",
                  "minLength": 1
                },
                "duration_minutes": {
                  "type": "integer",
                  "minimum": 1

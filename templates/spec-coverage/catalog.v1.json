{
  "catalog_version": 1,
  "core": [
    {
      "id": "data.entities",
      "label": "Entities",
      "answer_guidance": "Name every entity and its purpose; explicitly identify shared entities and relationships.",
      "examples": [
        {
          "entities": [
            "booking"
          ]
        }
      ],
      "value_schema": {
        "type": "object",
        "properties": {
          "entities": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "required": [
          "entities"
        ],
        "additionalProperties": false
      }
    },
    {
      "id": "data.fields",
      "label": "Fields",
      "answer_guidance": "For each entity field specify type, required/optional, identity and any default; examples never supply an approved default.",
      "examples": [
        {
          "fields": [
            {
              "entity": "booking",
              "name": "id",
              "type": "string",
              "required": true,
              "identity": true
            }
          ]
        }
      ],
      "value_schema": {
        "type": "object",
        "properties": {
          "fields": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "entity": {
                  "type": "string",
                  "minLength": 1
                },
                "name": {
                  "type": "string",
                  "minLength": 1
                },
                "type": {
                  "type": "string",
                  "minLength": 1
                },
                "required": {
                  "type": "boolean"
                },
                "identity": {
                  "type": "boolean"
                },
                "default": {}
              },
              "required": [
                "entity",
                "name",
                "type",
                "required",
                "identity"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "fields"
        ],
        "additionalProperties": false
      }
    },
    {
      "id": "validation.rules",
      "label": "Validation",
      "answer_guidance": "List accepted formats, ranges, cross-field rules and when each rule is enforced.",
      "examples": [
        {
          "rules": [
            "Name is required"
          ]
        }
      ],
      "value_schema": {
        "type": "object",
        "properties": {
          "rules": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "required": [
          "rules"
        ],
        "additionalProperties": false
      }
    },
    {
      "id": "duplicates.policy",
      "label": "Duplicate policy",
      "answer_guidance": "Define duplicate keys, scope, normalization and the behavior when concurrent requests claim the same key.",
      "examples": [
        {
          "key": [
            "customer",
            "date"
          ],
          "scope": "resource",
          "normalization": "trim",
          "race_behavior": "reject atomically"
        }
      ],
      "value_schema": {
        "type": "object",
        "properties": {
          "key": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "scope": {
            "type": "string",
            "minLength": 1
          },
          "normalization": {
            "type": "string",
            "minLength": 1
          },
          "race_behavior": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "key",
          "scope",
          "normalization",
          "race_behavior"
        ],
        "additionalProperties": false
      }
    },
    {
      "id": "workflow.statuses",
      "label": "Statuses",
      "answer_guidance": "Enumerate allowed statuses and initial/terminal statuses.",
      "examples": [
        {
          "statuses": [
            "active",
            "cancelled"
          ]
        }
      ],
      "value_schema": {
        "type": "object",
        "properties": {
          "statuses": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "required": [
          "statuses"
        ],
        "additionalProperties": false
      }
    },
    {
      "id": "workflow.transitions",
      "label": "Transitions",
      "answer_guidance": "Specify each allowed from/to transition, trigger and any preconditions; do not infer transitions from status names.",
      "examples": [
        {
          "transitions": [
            {
              "from": "active",
              "to": "cancelled",
              "condition": "customer requests"
            }
          ]
        }
      ],
      "value_schema": {
        "type": "object",
        "properties": {
          "transitions": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "from": {
                  "type": "string",
                  "minLength": 1
                },
                "to": {
                  "type": "string",
                  "minLength": 1
                },
                "condition": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "from",
                "to",
                "condition"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "transitions"
        ],
        "additionalProperties": false
      }
    },
    {
      "id": "actions.create",
      "label": "Create",
      "answer_guidance": "Decide create independently: use {\"enabled\": false} or {\"enabled\": true, \"behavior\": \"...\"}. Other actions never imply this decision.",
      "examples": [
        {
          "enabled": false
        }
      ],
      "value_schema": {
        "oneOf": [
          {
            "type": "object",
            "properties": {
              "enabled": {
                "const": false
              }
            },
            "required": [
              "enabled"

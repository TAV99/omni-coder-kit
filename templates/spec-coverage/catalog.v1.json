      "label": "Persistence",
      "answer_guidance": "Choose backend, data lifetime, reload behavior and whether multiple clients share changes.",
      "examples": [
        {
          "backend": "localStorage",
          "lifetime": "until cleared",
          "reload": "preserve",
          "multi_client": "not synchronized"
        }
      ],
      "value_schema": {
        "type": "object",
        "properties": {

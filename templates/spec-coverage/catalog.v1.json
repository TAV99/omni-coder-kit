  "extensions": {
    "booking": [
      {
        "id": "booking.hours",
        "label": "Operating hours",
        "answer_guidance": "Specify operating days, timezone, each open window and breaks; confirm boundaries rather than deriving hours from examples.",
        "examples": [
          {
            "days": [
              1,
              2,
              3,
              4,
              5
            ],
            "timezone": "Asia/Ho_Chi_Minh",
            "windows": [
              "08:00-12:00",
              "13:30-17:30"
            ],
            "breaks": [
              "12:00-13:30"
            ]
          }
        ],
        "value_schema": {
          "type": "object",
          "properties": {
            "days": {
              "type": "array",
              "items": {
                "type": "integer",
                "minimum": 0,
                "maximum": 6
              }
            },
            "timezone": {
              "type": "string",
              "minLength": 1
            },
            "windows": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "breaks": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "required": [
            "days",
            "timezone",
            "windows",
            "breaks"
          ],
          "additionalProperties": false
        }
      },
      {
        "id": "booking.slots",
        "label": "Slot generation",
        "answer_guidance": "Choose generated or fixed slots; specify duration_minutes and step_minutes separately, boundary behavior and fixed times when applicable.",
        "examples": [
          {
            "mode": "generated",
            "duration_minutes": 60,
            "step_minutes": 30,
            "boundary": "end within operating window"
          }
        ],
        "value_schema": {
          "type": "object",
          "properties": {
            "mode": {
              "enum": [
                "fixed",
                "generated"
              ]
            },
            "duration_minutes": {
              "type": "integer",
              "minimum": 1
            },
            "step_minutes": {
              "type": "integer",
              "minimum": 1
            },
            "boundary": {
              "type": "string",
              "minLength": 1
            },
            "times": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "required": [
            "mode",
            "duration_minutes",
            "step_minutes",
            "boundary"
          ],
          "additionalProperties": false
        },
        "dependencies": [
          "booking.hours"
        ]
      },
      {
        "id": "booking.capacity",
        "label": "Resource capacity",
        "answer_guidance": "Identify resource and capacity, overlap rules and atomic behavior for simultaneous claims by different customers.",
        "examples": [
          {
            "resource": "staff",
            "capacity": 1,
            "overlap": "reject",
            "concurrent_claims": "atomic first claim wins"
          }
        ],
        "value_schema": {
          "type": "object",
          "properties": {
            "resource": {
              "type": "string",
              "minLength": 1
            },
            "capacity": {
              "type": "integer",
              "minimum": 1
            },
            "overlap": {
              "type": "string",
              "minLength": 1
            },
            "concurrent_claims": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "resource",
            "capacity",
            "overlap",
            "concurrent_claims"
          ],
          "additionalProperties": false
        }
      },
      {
        "id": "booking.date_policy",
        "label": "Date policy",
        "answer_guidance": "Decide whether past dates are allowed and the booking horizon in days.",
        "examples": [
          {
            "past_dates": "reject",
            "horizon_days": 30
          }
        ],
        "value_schema": {
          "type": "object",
          "properties": {
            "past_dates": {
              "enum": [
                "allow",
                "reject"
              ]
            },
            "horizon_days": {
              "type": "integer",
              "minimum": 0
            }
          },
          "required": [
            "past_dates",
            "horizon_days"
          ],
          "additionalProperties": false
        }
      },
      {
        "id": "booking.services",
        "label": "Service catalog",
        "answer_guidance": "Approve service IDs, names and durations; proposed names are unresolved until approved. Match any shared catalog.items decision.",
        "examples": [
          {
            "items": [
              {
                "id": "consult",
                "name": "Consultation",
                "duration_minutes": 60
              }
            ]
          }
        ],
        "value_schema": {
          "type": "object",
          "properties": {
            "items": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "string",
                    "minLength": 1
                  },
                  "name": {
                    "type": "string",
                    "minLength": 1
                  },
                  "duration_minutes": {
                    "type": "integer",
                    "minimum": 1
                  }
                },
                "required": [
                  "id",
                  "name"
                ],
                "additionalProperties": false
              }
            }
          },
          "required": [
            "items"
          ],
          "additionalProperties": false
        },
        "shared_with": "catalog.items"
      },
      {
        "id": "booking.cancel_policy",
        "label": "Cancellation effects",
        "answer_guidance": "Specify cancellation cutoff, status effects and whether/when capacity is released.",
        "examples": [
          {
            "status_effect": "cancelled",
            "capacity_effect": "release",
            "cutoff": "before slot starts"
          }
        ],
        "value_schema": {
          "type": "object",
          "properties": {
            "status_effect": {
              "type": "string",
              "minLength": 1
            },
            "capacity_effect": {
              "type": "string",
              "minLength": 1
            },
            "cutoff": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "status_effect",
            "capacity_effect",
            "cutoff"
          ],
          "additionalProperties": false
        }
      }
    ]
  },

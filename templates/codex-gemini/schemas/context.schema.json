{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "summary",
    "relevant_files",
    "exact_symbols",
    "validation_commands",
    "constraints",
    "risks",
    "open_questions"
  ],
  "properties": {
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "relevant_files": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "description"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string"
          }
        }
      }
    },
    "exact_symbols": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "file",
          "verified"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "file": {
            "type": "string",
            "minLength": 1
          },
          "verified": {
            "type": "boolean"
          },
          "kind": {
            "type": "string"
          }
        }
      }
    },
    "validation_commands": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "constraints": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "risks": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "open_questions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "schema_version": {
      "const": 2
    },
    "coverage_findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "dimension_id",
          "reason",
          "evidence_refs"
        ],
        "properties": {
          "dimension_id": {
            "type": "string",
            "minLength": 1
          },
          "evidence_refs": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "reason": {
            "type": "string",
            "minLength": 1
          },
          "proposal": {},
          "value_schema": {
            "type": "object"
          }
        }
      }
    }
  },
  "dependencies": {
    "coverage_findings": [
      "schema_version"
    ],
    "schema_version": [
      "coverage_findings"
    ]
  }
}

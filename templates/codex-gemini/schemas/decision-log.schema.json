{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "array",
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "dimension_id",
      "chosen_value",
      "rationale",
      "evidence_refs"
    ],
    "properties": {
      "dimension_id": {
        "type": "string",
        "minLength": 1
      },
      "chosen_value": {},
      "rationale": {
        "type": "string",
        "minLength": 1
      },
      "evidence_refs": {
        "type": "array",
        "minItems": 1,
        "items": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
